[Unit]
Description=LMS FastAPI (Uvicorn)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=server
Group=server
WorkingDirectory=/data/projects/lms_fastapi
EnvironmentFile=-/data/projects/lms_fastapi/.env
ExecStart=/data/projects/lms_fastapi/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8002
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
