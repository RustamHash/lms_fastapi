# Database
DATABASE_URL=postgresql+asyncpg://lms_user:lms_password@postgres:5432/lms_fastapi

# JWT
JWT_SECRET_KEY=prod-secret-key-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# DaData
DADATA_TOKEN=
DADATA_SECRET=

# GeoSuggest
GEOSUGGEST_API_KEY=

# Logging
LOG_LEVEL=INFO
DEBUG_SQL=false
APP_LOG_FILE_PATH=logs/app.log
ERROR_LOG_FILE_PATH=logs/error.log
