# Database
DATABASE_URL=postgresql+asyncpg://lms_user:lms_password@localhost:5432/lms_fastapi

# JWT
JWT_SECRET_KEY=dev-secret-key-12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# DaData
DADATA_TOKEN=
DADATA_SECRET=

# GeoSuggest
GEOSUGGEST_API_KEY=

# Logging
LOG_LEVEL=INFO
DEBUG_SQL=true
APP_LOG_FILE_PATH=logs/app.log
ERROR_LOG_FILE_PATH=logs/error.log
SQL_LOG_FILE_PATH=logs/sql.log

# Redis / Celery (result по умолчанию — тот же host, DB /1)
REDIS_URL=redis://localhost:6379/0
